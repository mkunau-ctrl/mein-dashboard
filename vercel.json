{
  "redirects": [
    { "source": "/", "destination": "/start/", "permanent": false },
    { "source": "/dashboard", "destination": "/dashboard/", "permanent": false },
    { "source": "/ranglisten", "destination": "/ranglisten/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/dashboard/", "destination": "/index.html" },
    { "source": "/dashboard/:path+", "destination": "/:path+" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
